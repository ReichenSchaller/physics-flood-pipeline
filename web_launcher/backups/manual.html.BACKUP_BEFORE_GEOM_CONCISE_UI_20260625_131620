    function manualRenderCatalogDetection(result) {
      const target = document.getElementById('manual-catalog-detection-output');

      if (!target) {
        return;
      }

      const warnings = result.warnings || [];
      const catalogs = result.catalogs || [];
      const suggestions = result.suggested_config || {};

      const warningHtml = warnings.map(warning => `
        <div class="check-item warn">
          <div class="check-status">WARN</div>
          <div><b>Catalog detector warning</b><br><span class="muted">${manualReviewEsc(warning)}</span></div>
        </div>
      `).join('');

      const catalogHtml = catalogs.map(item => {
        const found = item.found || {};
        const foundRows = Object.entries(found)
          .filter(([key, value]) => {
            if (Array.isArray(value)) return value.length > 0;
            return Boolean(value);
          })
          .map(([key, value]) => {
            const displayValue = Array.isArray(value) ? value.join(', ') : value;
            return `<div><b>${manualReviewEsc(key)}</b>: <code>${manualReviewEsc(displayValue)}</code></div>`;
          })
          .join('');

        return `
          <div class="check-item good">
            <div class="check-status">FOUND</div>
            <div>
              <b>${manualReviewEsc(item.name || item.path || 'catalog')}</b><br>
              <span class="muted">Roles: ${(item.roles || []).map(manualReviewEsc).join(', ') || 'unknown'}</span>
              <div style="margin-top: 8px;">${foundRows || '<span class="muted">No known catalog products detected.</span>'}</div>
            </div>
          </div>
        `;
      }).join('');

      const suggestionRows = Object.entries(suggestions).map(([key, value]) => `
        <div><b>${manualReviewEsc(key)}</b>: <code>${manualReviewEsc(JSON.stringify(value))}</code></div>
      `).join('');

      const suggestionHtml = `
        <div class="check-item ${Object.keys(suggestions).length ? 'good' : 'warn'}">
          <div class="check-status">${Object.keys(suggestions).length ? 'SUGGEST' : 'NONE'}</div>
          <div>
            <b>Suggested Manual autofill values</b><br>
            ${suggestionRows || '<span class="muted">No autofill suggestions were produced.</span>'}
          </div>
        </div>
      `;

      target.innerHTML = warningHtml + catalogHtml + suggestionHtml;
    }


    async function manualRenderNativeCatalogWarnings() {
      const target = document.getElementById('manual-catalog-detection-output');

      if (!target) {
        return;
      }


      let cfg;

      try {
        cfg = getConfig();
      } catch (err) {
        const warning = document.createElement('div');
        warning.className = 'check-item warn';
        warning.innerHTML = `
          <div class="check-status">WARN</div>
          <div>
            <b>Native-file catalog warning scan could not read current config.</b><br>
            <span class="muted">${manualReviewEsc(err.message)}</span>
          </div>
        `;
        target.prepend(warning);
        return;
      }

      try {
        const response = await fetch('/api/manual-catalog-native-warning', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ config: cfg })
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.error || 'Native-file catalog warning scan failed.');
        }

        const findings = result.findings || [];
        const reviewFindings = findings.filter(item => !item.allowed);

        if (!reviewFindings.length) {
          return;
        }

        const warningBlock = document.createElement('div');
        warningBlock.className = 'check-item warn';

        const rows = reviewFindings.slice(0, 80).map(item => {
          const prefix = 'REVIEW';
          const pathText = item.path ? `: ${item.path}` : '';
          return `${prefix}: ${item.reason}${pathText}`;
        }).join('\n');

        const hardCount = reviewFindings.length;

        warningBlock.innerHTML = `
          <div class="check-status">WARN</div>
          <div>
            <b>Native-like files found in selected data catalogs.</b><br>
            <span class="muted">
              Manual raw mode expects clean curated source data. Native/reference SFINCS files
              should be quarantined or moved to Override mode. Curated active-mask rasters and validation .xy/.xyxy products should not appear in this warning.
              Findings: ${hardCount}.
            </span>
            <pre style="white-space: pre-wrap; margin-top: 8px; max-height: 220px; overflow: auto;">${manualReviewEsc(rows)}</pre>
          </div>
        `;

        target.prepend(warningBlock);
      } catch (err) {
        const warning = document.createElement('div');
        warning.className = 'check-item warn';
        warning.innerHTML = `
          <div class="check-status">WARN</div>
          <div>
            <b>Native-file catalog warning scan failed.</b><br>
            <span class="muted">${manualReviewEsc(err.message)}</span>
          </div>
        `;
        target.prepend(warning);
      }
    }


