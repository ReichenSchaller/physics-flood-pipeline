<!-- BEGIN runtime launcher path defaults patch -->
<script>
(function () {
  "use strict";

  const FIELD_TO_DEFAULT = {
    project_root: "projectRoot",
    conda_env_path: "condaEnvPath",
    conda_python: "condaPython",
    sfincs_container: "sfincsContainerPath",
    sfincs_container_path: "sfincsContainerPath"
  };

  const BUILTIN_DEFAULTS = {
    projectRoot: "/proj/zefflab/projects/Flooding/pipeline",
    condaEnvPath: "/proj/zefflab/projects/Flooding/pipeline/envs/sfincs",
    condaPython: "/proj/zefflab/projects/Flooding/pipeline/envs/sfincs/bin/python",
    sfincsContainerPath: "/proj/zefflab/projects/Flooding/pipeline/containers/sfincs-v2.3.0-mt-Faber-Release.sif"
  };

  function defaultsApi() {
    return window.SFINCS_LAUNCHER_DEFAULTS ||
           window.SfincsLauncherDefaults ||
           window.launcherDefaults ||
           {};
  }

  function getLauncherDefault(key) {
    const api = defaultsApi();

    if (typeof api.getDefault === "function") {
      return api.getDefault(key) || BUILTIN_DEFAULTS[key] || "";
    }

    if (typeof api.get === "function") {
      return api.get(key) || BUILTIN_DEFAULTS[key] || "";
    }

    if (typeof api.getAll === "function") {
      const all = api.getAll() || {};
      return all[key] || BUILTIN_DEFAULTS[key] || "";
    }

    if (api.defaults && api.defaults[key]) {
      return api.defaults[key];
    }

    return BUILTIN_DEFAULTS[key] || "";
  }

  function applyRuntimeLauncherPathDefaults(force) {
    Object.entries(FIELD_TO_DEFAULT).forEach(([fieldKey, defaultKey]) => {
      const input = document.querySelector(`[data-key="${fieldKey}"]`);
      if (!input) return;

      const desired = String(getLauncherDefault(defaultKey) || "").trim();
      if (!desired) return;

      const current = String(input.value || "").trim();
      const builtin = String(BUILTIN_DEFAULTS[defaultKey] || "").trim();

      const safeToApply =
        force ||
        !current ||
        current === builtin ||
        input.dataset.appliedLauncherDefault === "true";

      if (!safeToApply) return;

      input.value = desired;
      input.dataset.appliedLauncherDefault = "true";
      input.dispatchEvent(new Event("input", {bubbles: true}));
      input.dispatchEvent(new Event("change", {bubbles: true}));
    });

    if (typeof window.updatePreview === "function") {
      window.updatePreview();
    }
  }

  window.applyRuntimeLauncherPathDefaults = applyRuntimeLauncherPathDefaults;

  document.addEventListener("DOMContentLoaded", function () {
    setTimeout(function () {
      applyRuntimeLauncherPathDefaults(false);
    }, 0);
  });

  window.addEventListener("launcher-defaults-changed", function () {
    applyRuntimeLauncherPathDefaults(true);
  });
})();
</script>
<!-- END runtime launcher path defaults patch -->

<!-- BEGIN permanent tab scrollbar script -->
<script>
(function () {
  "use strict";

  function clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
  }

  function installOneTabScrollbar(strip) {
    if (!strip || strip.dataset.permanentScrollbarReady === "true") return;

    const bar = document.createElement("div");
    bar.className = "permanent-tab-scrollbar";
    bar.setAttribute("aria-hidden", "true");

    const thumb = document.createElement("div");
    thumb.className = "permanent-tab-scrollbar-thumb";

    bar.appendChild(thumb);
    strip.insertAdjacentElement("afterend", bar);

    strip.dataset.permanentScrollbarReady = "true";

    let dragging = false;
    let dragStartX = 0;
    let dragStartScrollLeft = 0;

    function update() {
      const maxScroll = strip.scrollWidth - strip.clientWidth;

      if (strip.clientWidth <= 0 || maxScroll <= 1) {
        bar.hidden = true;
        return;
      }

      bar.hidden = false;

      const barWidth = bar.clientWidth;
      const visibleRatio = strip.clientWidth / strip.scrollWidth;
      const thumbWidth = clamp(barWidth * visibleRatio, 80, barWidth);
      const maxThumbLeft = Math.max(0, barWidth - thumbWidth);
      const thumbLeft = maxScroll > 0
        ? (strip.scrollLeft / maxScroll) * maxThumbLeft
        : 0;

      thumb.style.width = `${thumbWidth}px`;
      thumb.style.transform = `translateX(${thumbLeft}px)`;
    }

    function scrollFromPointer(clientX) {
      const rect = bar.getBoundingClientRect();
      const thumbWidth = thumb.getBoundingClientRect().width || 80;
      const maxThumbLeft = Math.max(0, rect.width - thumbWidth);
      const x = clamp(clientX - rect.left - thumbWidth / 2, 0, maxThumbLeft);
      const maxScroll = strip.scrollWidth - strip.clientWidth;

      strip.scrollLeft = maxThumbLeft > 0
        ? (x / maxThumbLeft) * maxScroll
        : 0;
    }

    strip.addEventListener("scroll", update, {passive: true});
    window.addEventListener("resize", update);

    bar.addEventListener("pointerdown", function (event) {
      event.preventDefault();
      bar.setPointerCapture(event.pointerId);

      if (event.target === thumb) {
        dragging = true;
        dragStartX = event.clientX;
        dragStartScrollLeft = strip.scrollLeft;
      } else {
        scrollFromPointer(event.clientX);
        update();
      }
    });

    bar.addEventListener("pointermove", function (event) {
      if (!dragging) return;

      const maxScroll = strip.scrollWidth - strip.clientWidth;
      const barWidth = bar.clientWidth;
      const thumbWidth = thumb.getBoundingClientRect().width || 80;
      const maxThumbLeft = Math.max(1, barWidth - thumbWidth);
      const dx = event.clientX - dragStartX;

      strip.scrollLeft = dragStartScrollLeft + (dx / maxThumbLeft) * maxScroll;
      update();
    });

    bar.addEventListener("pointerup", function (event) {
      dragging = false;
      try {
        bar.releasePointerCapture(event.pointerId);
      } catch (_) {}
    });

    bar.addEventListener("pointercancel", function () {
      dragging = false;
    });

    strip.addEventListener("wheel", function () {
      setTimeout(update, 0);
    }, {passive: true});

    setTimeout(update, 0);
    setTimeout(update, 250);
  }

  function installTabScrollbars() {
    document
      .querySelectorAll(".tab-strip, .step-strip, .manual-tab-strip")
      .forEach(installOneTabScrollbar);

    updateTabScrollbars();
  }

  function updateTabScrollbars() {
    document
      .querySelectorAll(".tab-strip, .step-strip, .manual-tab-strip")
      .forEach((strip) => {
        const bar = strip.nextElementSibling;
        if (!bar || !bar.classList.contains("permanent-tab-scrollbar")) return;

        const thumb = bar.querySelector(".permanent-tab-scrollbar-thumb");
        const maxScroll = strip.scrollWidth - strip.clientWidth;

        if (strip.clientWidth <= 0 || maxScroll <= 1) {
          bar.hidden = true;
          return;
        }

        bar.hidden = false;

        const barWidth = bar.clientWidth;
        const visibleRatio = strip.clientWidth / strip.scrollWidth;
        const thumbWidth = clamp(barWidth * visibleRatio, 80, barWidth);
        const maxThumbLeft = Math.max(0, barWidth - thumbWidth);
        const thumbLeft = maxScroll > 0
          ? (strip.scrollLeft / maxScroll) * maxThumbLeft
          : 0;

        thumb.style.width = `${thumbWidth}px`;
        thumb.style.transform = `translateX(${thumbLeft}px)`;
      });
  }

  window.updatePermanentTabScrollbars = updateTabScrollbars;

  document.addEventListener("DOMContentLoaded", installTabScrollbars);
  window.addEventListener("load", installTabScrollbars);
  window.addEventListener("resize", updateTabScrollbars);

  document.addEventListener("click", function () {
    setTimeout(updateTabScrollbars, 50);
  });
})();
</script>
<!-- END permanent tab scrollbar script -->




<!-- RUN NAME AUTO COMBO START -->

<script>

(function () {

  function byKey(key) {

    return document.querySelector('[data-key="' + key + '"]');

  }



  function cleanPart(value) {

    return String(value || "")

      .trim()

      .replace(/\s+/g, "_")

      .replace(/[^A-Za-z0-9_.-]+/g, "_")

      .replace(/_+/g, "_")

      .replace(/^_+|_+$/g, "");

  }



  function comboName() {

    const eventEl = byKey("event_name");

    const seriesEl = byKey("run_series");

    const eventName = cleanPart(eventEl ? eventEl.value : "");

    const runSeries = cleanPart(seriesEl ? seriesEl.value : "");

    if (eventName && runSeries) return eventName + "_" + runSeries;

    return eventName || runSeries || "";

  }



  function installRunNameAutoCombo() {

    const eventEl = byKey("event_name");

    const seriesEl = byKey("run_series");

    const runNameEl = byKey("run_name");



    if (!runNameEl || !eventEl || !seriesEl) return;

    if (runNameEl.dataset.autoComboInstalled === "true") return;

    runNameEl.dataset.autoComboInstalled = "true";



    let updatingFromParts = false;



    function refreshFromParts() {

      const next = comboName();

      if (!next) return;

      updatingFromParts = true;

      runNameEl.value = next;

      runNameEl.dispatchEvent(new Event("input", { bubbles: true }));

      runNameEl.dispatchEvent(new Event("change", { bubbles: true }));

      updatingFromParts = false;

    }



    eventEl.addEventListener("input", refreshFromParts);

    eventEl.addEventListener("change", refreshFromParts);

    seriesEl.addEventListener("input", refreshFromParts);

    seriesEl.addEventListener("change", refreshFromParts);



    runNameEl.addEventListener("input", function () {

      if (updatingFromParts) return;

      runNameEl.dataset.userEditedRunName = "true";

    });



    // On a blank fresh page, fill from event + series.

    // On loaded/saved configs, preserve the loaded run_name until event_name/run_series changes.

    if (!String(runNameEl.value || "").trim()) {

      refreshFromParts();

    }

  }



  if (document.readyState === "loading") {

    document.addEventListener("DOMContentLoaded", installRunNameAutoCombo);

  } else {

    installRunNameAutoCombo();

  }



  window.installRunNameAutoCombo = installRunNameAutoCombo;

})();

</script>

<!-- RUN NAME AUTO COMBO END -->


