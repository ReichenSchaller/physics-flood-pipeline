          'Only use this when intentionally replacing a prior run folder.'
        ));
      }


      const forcingOn = Boolean(cfg.use_rainfall || cfg.use_waterlevel_boundary || cfg.use_discharge_boundary || cfg.use_wind || cfg.use_pressure);
      if (!cfg.require_at_least_one_forcing || forcingOn || cfg.allow_missing_model_inputs) {
        checks.push(makeCheck('good', 'Forcing safety check passed.', `forcing enabled = ${forcingOn}`));
