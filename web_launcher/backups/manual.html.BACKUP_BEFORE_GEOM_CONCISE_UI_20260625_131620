    function runChecks(navigate = true) {
      const cfg = getConfig();
      checksOutput.innerHTML = '';
      const checks = [];
    
      runRuntimeWindowReviewCheck();

      if (/^[A-Za-z0-9_.-]+$/.test(cfg.run_name || '')) {
        checks.push(makeCheck('good', 'run_name format is safe.', cfg.run_name));
      } else {
        checks.push(makeCheck('bad', 'run_name has unsafe characters.', 'Use only letters, numbers, underscores, dashes, and periods.'));
      }

      if (cfg.output_root) {
        checks.push(makeCheck('good', 'output_root is set.', cfg.output_root));
      } else {
        checks.push(makeCheck('bad', 'output_root is blank.', 'The backend needs a root folder for run outputs.'));
      }

      if (lastStoreCumPrecipImportRepair) {
        checks.push(makeCheck(
          'good',
          'Loaded config was upgraded for cumulative precipitation storage.',
          `${lastStoreCumPrecipImportRepair} The next saved/submitted Manual config will not preserve top-level storecumprcp.`
        ));
      }

      if (cfg.project_root) {
        checks.push(makeCheck('good', 'project_root is set.', cfg.project_root));
      } else {
        checks.push(makeCheck('bad', 'project_root is blank.', 'The backend needs the pipeline bundle root.'));
      }

      function parseManualDate(value) {
        const text = String(value || '').trim();

        if (!text) {
          return null;
        }

        const normalized = text.includes('T') ? text : text.replace(' ', 'T');
        const date = new Date(normalized);

        return Number.isNaN(date.getTime()) ? null : date;
      }

      const trefDate = parseManualDate(cfg.tref);
      const tstartDate = parseManualDate(cfg.tstart);
      const tstopDate = parseManualDate(cfg.tstop);

      if (trefDate && tstartDate && tstopDate) {
        checks.push(makeCheck(
          'good',
          'Model time fields parse as dates.',
          `tref=${cfg.tref}, tstart=${cfg.tstart}, tstop=${cfg.tstop}`
        ));

        if (tstartDate < tstopDate) {
          checks.push(makeCheck(
            'good',
            'Model time order is valid.',
            'tstart is before tstop.'
          ));
        } else {
          checks.push(makeCheck(
            'bad',
            'Model time order is invalid.',
            'tstart must be before tstop.'
          ));
        }

        if (trefDate <= tstartDate) {
          checks.push(makeCheck(
            'good',
            'tref is not after tstart.',
            'Good for normal SFINCS timing.'
          ));
        } else {
          checks.push(makeCheck(
            'warn',
            'tref is after tstart.',
            'This is unusual; confirm it is intentional.'
          ));
        }
      } else {
        checks.push(makeCheck(
          'bad',
          'One or more model time fields could not be parsed.',
          'Check tref, tstart, and tstop format.'
        ));
      }

      const outputIntervals = [
        ['dtout_s', cfg.dtout_s],
        ['dthisout_s', cfg.dthisout_s],
        ['dtrstout_s', cfg.dtrstout_s],
        ['meteo_update_interval_s', cfg.meteo_update_interval_s],
      ];

      outputIntervals.forEach(([key, value]) => {
        if (Number(value) > 0) {
          checks.push(makeCheck(
            'good',
            `${key} is positive.`,
            String(value)
          ));
        } else {
          checks.push(makeCheck(
            'bad',
            `${key} must be positive.`,
            String(value)
          ));
        }
      });

      if (Number(cfg.grid_dx_m) > 0 && Number(cfg.grid_dy_m) > 0) {
        checks.push(makeCheck(
          'good',
          'Grid spacing is positive.',
          `dx=${cfg.grid_dx_m}, dy=${cfg.grid_dy_m}`
        ));
      } else {
        checks.push(makeCheck(
          'bad',
          'Grid spacing must be positive.',
          `dx=${cfg.grid_dx_m}, dy=${cfg.grid_dy_m}`
        ));
      }

      function asList(value) {
        if (Array.isArray(value)) {
          return value;
        }

        if (value === null || value === undefined || value === '') {
          return [];
        }

        if (typeof value === 'string') {
          const trimmed = value.trim();

          if (!trimmed) {
            return [];
          }

          try {
            const parsed = JSON.parse(trimmed);
            return Array.isArray(parsed) ? parsed : [parsed];
          } catch (err) {
            return trimmed
              .replaceAll(',', '\n')
              .split('\n')
              .map(item => item.trim())
              .filter(Boolean);
          }
        }

        return [value];
      }

      function isBlank(value) {
        return value === null || value === undefined || String(value).trim() === '';
      }

      function hasAnyValue(keys) {
        return keys.some(key => !isBlank(cfg[key]));
      }

      // Manual-mode identity checks.
      if (cfg.preprocess_mode === 'hydromt_build') {
        checks.push(makeCheck(
          'good',
          'Manual preprocess mode is fixed to hydromt_build.',
          'Hybrid/native assembly should stay in Override Mode.'
        ));
      } else {
        checks.push(makeCheck(
          'bad',
          'Manual preprocess mode is not hydromt_build.',
          `Current preprocess_mode = ${cfg.preprocess_mode}. Manual v1.1 should stay hydromt_build.`
        ));
      }

      if (cfg.pipeline_mode === 'preflight_only') {
        checks.push(makeCheck(
          'good',
          'Manual hidden pipeline_mode default is safe.',
          'Submit/build actions are chosen by the final Submit tab buttons.'
        ));
      } else {
        checks.push(makeCheck(
          'warn',
          'Hidden pipeline_mode is not the safe default.',
          `Current pipeline_mode = ${cfg.pipeline_mode}. The Submit tab will still override it when staging.`
        ));
      }

      // Data catalog sanity.
      const catalogList = asList(cfg.data_catalogs);

      if (catalogList.length > 0) {
        checks.push(makeCheck(
          'good',
          'At least one data catalog/source is listed.',
          catalogList.join(', ')
        ));
      } else {
        checks.push(makeCheck(
          'bad',
          'data_catalogs is empty.',
          'HydroMT-build Manual Mode needs at least one usable data catalog or named source collection.'
        ));
      }

      if (catalogList.length === 1 && String(catalogList[0]).trim() === 'artifact_data') {
        checks.push(makeCheck(
          'warn',
          'data_catalogs still uses artifact_data.',
          'This is okay for a tiny artifact test, but probably wrong for a real Harris County run.'
        ));
      }



      // Required/important visible path defaults.
      if (cfg.region_mode === 'geom') {
        if (isBlank(cfg.region_path)) {
          checks.push(makeCheck(
            'bad',
            'region_mode is geom but region_path is blank.',
            'Use Browse to select a region GeoJSON, or switch region_mode to bbox and fill region_bbox.'
          ));
        } else {
          checks.push(makeCheck(
            'good',
            'Region geometry path is set.',
            cfg.region_path
          ));
        }
      }

