      if (lastLoadedUnmatchedKeys.length > 0) {
        checks.push(makeCheck(
          'warn',
          'Loaded config has extra backend keys preserved.',
          `${lastLoadedUnmatchedKeys.length} key(s): ${lastLoadedUnmatchedKeys.slice(0, 12).join(', ')}${lastLoadedUnmatchedKeys.length > 12 ? ', ...' : ''}`
        ));
      } else {
        checks.push(makeCheck(
          'good',
