      }      
      

      const badCount = checks.filter(c => c.classList.contains('bad')).length;
      const warnCount = checks.filter(c => c.classList.contains('warn')).length;
    
      const summary = makeCheck(
        badCount > 0 ? 'bad' : warnCount > 0 ? 'warn' : 'good',
        'Manual page checks complete.',
        `${badCount} fail(s), ${warnCount} warning(s), ${checks.length} total check(s).`
      );
    
      checksOutput.appendChild(summary);
      checks.forEach(c => checksOutput.appendChild(c));
    
      if (navigate) {
        showTab('tab-check');
      }
    }

    async function saveConfig(confirmUpdate = false) {
      const cfg = getConfig();
    
      const response = await fetch('/api/save-config', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          config: cfg,
          confirm_update: confirmUpdate
        })
      });
    
      const data = await response.json().catch(() => ({}));
    
      if (response.status === 409 && data.needs_confirmation) {
        let message = data.message || 'A saved config already exists. Update it?';
    
        if (data.run_state && data.run_state.has_real_run) {
          message += '\n\nWarning: this run folder also appears to contain real run artifacts. Updating run_config.json could make the saved config differ from what was actually run.';
        }
    
        if (confirm(message)) {
          return saveConfig(true);
        }
    
        return data;
      }
    
      if (!response.ok || !data.ok) {
        const message = data.message || data.error || `Save failed with HTTP ${response.status}`;
        alert(message);
        throw new Error(message);
      }
    
      alert(
        data.updated_existing
          ? `Updated saved config:\n${data.config_path}`
          : `Saved config:\n${data.config_path}`
      );
    
      return data;
}

    async function loadConfigFromFile(file) {
      if (!file) return;
      const text = await file.text();
      let cfg;
      try {
        cfg = JSON.parse(text);
      } catch (err) {
        alert(`Could not parse JSON file:\n${err.message}`);
        return;
      }
      let matched = 0;
      const unmatched = [];
    
      // Reset preserved extras each time a new file is loaded.
      extraLoadedConfig = {};
      lastLoadedUnmatchedKeys = [];
      lastStoreCumPrecipImportRepair = "";

      manualMigrateLegacyTopLevelStoreCumPrecip(cfg);
    
      Object.entries(cfg).forEach(([key, value]) => {
        if (setFieldValue(key, value)) {
          matched += 1;
        } else if (!MANUAL_STRIP_LOADED_KEYS.has(key) && !(key in MANUAL_FIXED_CONFIG)) {
          unmatched.push(key);
          extraLoadedConfig[key] = value;
        }
      });
    
      lastLoadedUnmatchedKeys = unmatched;

      const repairedCfg = getConfig();
      manualSyncStoreCumulativePrecip(repairedCfg, {
        writeBackToPage: true,
        recordRepair: true
      });
    
      updatePreview();
    
      alert(
        `Loaded config.\n\n` +
        `Matched visible fields: ${matched}\n` +
        `Extra backend keys preserved: ${unmatched.length}`
      );
    }

