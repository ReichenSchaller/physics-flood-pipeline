    function setGeometryButtonState(button, state, originalLabel) {
      if (!button) return;

      if (!button.dataset.originalLabel) {
        button.dataset.originalLabel = originalLabel || button.textContent;
      }

      if (state === 'busy') {
        button.disabled = true;
        button.textContent = '⏳ Running...';
        return;
      }

      if (state === 'good') {
        button.disabled = false;
        button.textContent = '✅ Passed';
        setTimeout(() => {
          button.textContent = button.dataset.originalLabel;
        }, 2200);
        return;
      }

      if (state === 'bad') {
        button.disabled = false;
        button.textContent = '❌ Failed';
        setTimeout(() => {
          button.textContent = button.dataset.originalLabel;
        }, 3200);
        return;
      }

      if (state === 'submitted') {
        button.disabled = false;
        button.textContent = '✅ Submitted';
        setTimeout(() => {
          button.textContent = button.dataset.originalLabel;
        }, 2200);
        return;
      }

      button.disabled = false;
      button.textContent = button.dataset.originalLabel;
    }

    function renderGeometryCheckResult(result, modeLabel) {
      const target = document.getElementById('geometry-check-output');
      if (!target) return;

      const pieces = [];

      pieces.push(`GEOMETRY CHECK: ${modeLabel}`);
      pieces.push('='.repeat(100));

      if (result.http_status || result.http_status_text) {
        pieces.push(`HTTP: ${result.http_status || ''} ${result.http_status_text || ''}`.trim());
      }

      if (result.job_id) {
        pieces.push(`Submitted Slurm job: ${result.job_id}`);
      }

      if (result.audit_path) {
        pieces.push(`Audit JSON: ${result.audit_path}`);
      }

      if (result.script_path) {
        pieces.push(`Script: ${result.script_path}`);
      }

      if (result.stdout) {
        pieces.push('');
        pieces.push('STDOUT');
        pieces.push('-'.repeat(100));
        pieces.push(result.stdout);
      }

      if (result.stderr) {
        pieces.push('');
        pieces.push('STDERR');
        pieces.push('-'.repeat(100));
        pieces.push(result.stderr);
      }

      pieces.push('');
      pieces.push('RAW JSON RESPONSE');
      pieces.push('-'.repeat(100));
      pieces.push(JSON.stringify(result, null, 2));

      if (result.audit) {
        pieces.push('');
        pieces.push('AUDIT JSON SUMMARY');
        pieces.push('-'.repeat(100));
        pieces.push(JSON.stringify({
          ok: result.audit.ok,
          status: result.audit.status,
          summary: result.audit.summary,
          error_type: result.audit.error_type,
          error_message: result.audit.error_message,
        }, null, 2));
      }

      if (result.error) {
        pieces.push('');
        pieces.push('ERROR');
        pieces.push('-'.repeat(100));
        pieces.push(result.error);
      }

      if (result.traceback) {
        pieces.push('');
        pieces.push('TRACEBACK');
        pieces.push('-'.repeat(100));
        pieces.push(result.traceback);
      }

      if (result.raw_response) {
        pieces.push('');
        pieces.push('RAW RESPONSE');
        pieces.push('-'.repeat(100));
        pieces.push(result.raw_response);
      }

      target.textContent = pieces.join('\n');
    }

    async function runManualGeometryCheckLocal() {
      const button = document.getElementById('geometry-check-local-button');
      const target = document.getElementById('geometry-check-output');

      setGeometryButtonState(button, 'busy', 'Run Geometry Check Locally');

      if (target) {
        target.textContent = 'Running local geometry check on the Flask/backend node...';
