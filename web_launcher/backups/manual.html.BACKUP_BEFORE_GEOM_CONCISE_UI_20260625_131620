    function manualRemoveCatalog(index) {
      const current = manualCatalogReadList();
      current.splice(index, 1);
      manualCatalogWriteList(current);
    }

    function manualRenderCatalogList() {
      const target = document.getElementById('manual-catalog-list');

      if (!target) {
        return;
      }

      const items = manualCatalogReadList();

      if (!items.length) {
        target.innerHTML = '<span class="muted">No data catalogs selected.</span>';
