  <script>
    const tabs = document.querySelectorAll('.tab');
    const panels = document.querySelectorAll('.tab-panel');
    const preview = document.getElementById('config-preview');
    const runRootPreview = document.getElementById('run-root-preview');
    const sideRunRootPreview = document.getElementById('side-run-root-preview');
    const checksOutput = document.getElementById('checks-output');
    
    let extraLoadedConfig = {};
    let lastLoadedUnmatchedKeys = [];
    let lastStoreCumPrecipImportRepair = "";

    const MANUAL_FIXED_CONFIG = {
      pipeline_mode: 'preflight_only',
      preprocess_mode: 'hydromt_build',
      use_sfincs_file_overrides: false
    };
    
    const MANUAL_STRIP_LOADED_KEYS = new Set([
      // Override/native workflow metadata should not survive into Manual Mode.
      'native_static_sfincs_input_dirs',
      'native_event_sfincs_input_dirs',
      'native_sfincs_input_dirs',
      'sfincs_file_overrides',
      'use_mask_template',
      'mask_template_path',
      'mask_template_mode',
      'override_source_path',
      'sfincs_file_override_search_dirs',
      'override_source_paths',
      'override_detection_manifest',
      'grid_source',
      'grid_template_path',
      'grid_template_mode',
      'grid_template_use_as_active_mask',
      'override_locked_config_keys',
      'override_locked_sections',
      'override_lock_reasons',
        
      // Runner-created metadata from old saved configs should not be re-saved as user intent.
      'runner_file',
      'created_at',
      'created_by_user',
      'runner_python',
      'runner_python_version',
      'source_config_path'
    ]);
    
function applyManualFixedConfig(cfg) {
  const out = { ...(cfg || {}) };

  const manualStripConfigKeys = [
    'use_mask_template',
    'mask_template_path',
    'mask_template_mode',
    'native_static_sfincs_input_dirs',
    'native_event_sfincs_input_dirs',
    'native_sfincs_input_dirs',
    'sfincs_file_override_search_dirs',
    'sfincs_file_overrides',
    'override_source_path',
    'override_source_paths',
    'override_detection_manifest',
    'runner_file',
    'created_at',
    'created_by_user',
    'runner_python',
    'runner_python_version',
    'source_config_path',
    'grid_source',
    'grid_template_path',
    'grid_template_mode',
    'grid_template_use_as_active_mask',
    'override_locked_config_keys',
    'override_locked_sections',
    'override_lock_reasons',
  ];

  for (const key of manualStripConfigKeys) {
    delete out[key];
  }

  if (typeof extraLoadedConfig === 'object' && extraLoadedConfig) {
    for (const key of manualStripConfigKeys) {
      delete extraLoadedConfig[key];
    }
  }

  return { ...out, ...MANUAL_FIXED_CONFIG };
}

    function showTab(tabId) {
      tabs.forEach(tab => tab.classList.toggle('active', tab.dataset.tab === tabId));
      panels.forEach(panel => panel.classList.toggle('active', panel.id === tabId));
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function parseValue(el) {
      const type = el.dataset.type || 'string';
      const raw = el.value;
      const trimmed = raw.trim();

      if (type === 'string') return raw;
      if (type === 'nullable') return trimmed === '' ? null : raw;
      if (type === 'bool') return raw === 'true';
      if (type === 'int') return trimmed === '' ? null : parseInt(trimmed, 10);
      if (type === 'float') return trimmed === '' ? null : parseFloat(trimmed);
      if (type === 'nullable_float') return trimmed === '' ? null : parseFloat(trimmed);
      if (type === 'string_or_number') {
        if (trimmed === '') return '';
        const num = Number(trimmed);
        return Number.isFinite(num) && String(num) === trimmed ? num : raw;
      }
      if (type === 'json') return JSON.parse(trimmed || 'null');
      if (type === 'nullable_json') return trimmed === '' ? null : JSON.parse(trimmed);
      return raw;
    }

    function stringifyForField(value, type) {
      if (value === null || value === undefined) return '';
      if (type === 'json' || type === 'nullable_json') return JSON.stringify(value, null, 2);
      return String(value);
    }

    function manualSyncDemSourceZmin(cfg) {
      if (!cfg || typeof cfg !== 'object') {
        return cfg;
      }

      const z = Number(cfg.dem_zmin);

      if (!Number.isFinite(z)) {
        return cfg;
      }

      if (Array.isArray(cfg.hydromt_dem_sources)) {
        cfg.hydromt_dem_sources = cfg.hydromt_dem_sources.map(src => {
          if (src && typeof src === 'object' && src.elevation) {
            return { ...src, zmin: z };
          }
          return src;
        });
      }

      return cfg;
    }

    function manualMigrateLegacyTopLevelStoreCumPrecip(cfg) {
      if (!cfg || typeof cfg !== 'object') {
        return cfg;
      }

      if (!Object.prototype.hasOwnProperty.call(cfg, 'storecumprcp')) {
        return cfg;
      }

      const legacyRaw = cfg.storecumprcp;
      const legacyText = String(legacyRaw).trim().toLowerCase();
      const legacyOn = !(
        legacyRaw === 0 ||
        legacyRaw === false ||
        legacyText === '0' ||
        legacyText === 'false' ||
        legacyText === 'off' ||
        legacyText === 'no'
      );

      if (!cfg.advanced_config || typeof cfg.advanced_config !== 'object' || Array.isArray(cfg.advanced_config)) {
        cfg.advanced_config = {};
      }

      if (!Object.prototype.hasOwnProperty.call(cfg, 'store_cumulative_precip')) {
        cfg.store_cumulative_precip = legacyOn;
      }

      if (!Object.prototype.hasOwnProperty.call(cfg.advanced_config, 'storecumprcp')) {
        cfg.advanced_config.storecumprcp = cfg.store_cumulative_precip !== false ? 1 : 0;
      }

      delete cfg.storecumprcp;

      lastStoreCumPrecipImportRepair =
        'Migrated legacy top-level storecumprcp into store_cumulative_precip / advanced_config.storecumprcp and removed the legacy key.';

      return cfg;
    }

    function manualSyncStoreCumulativePrecip(cfg, options = {}) {
      if (!cfg || typeof cfg !== 'object') {
        return cfg;
      }

      const writeBackToPage = Boolean(options.writeBackToPage);
      const recordRepair = Boolean(options.recordRepair);

      if (!cfg.advanced_config || typeof cfg.advanced_config !== 'object' || Array.isArray(cfg.advanced_config)) {
        cfg.advanced_config = {};
      }

      const before = cfg.advanced_config.storecumprcp;
      const hadRawKey = Object.prototype.hasOwnProperty.call(cfg.advanced_config, 'storecumprcp');
      const hadUiKey = Object.prototype.hasOwnProperty.call(cfg, 'store_cumulative_precip');

      const storeOn = cfg.store_cumulative_precip !== false;
      cfg.store_cumulative_precip = storeOn;
      cfg.advanced_config.storecumprcp = storeOn ? 1 : 0;

      if (recordRepair) {
        if (!hadUiKey) {
          lastStoreCumPrecipImportRepair =
            'Loaded config was missing store_cumulative_precip; defaulted it to true.';
        }

        if (!hadRawKey) {
          lastStoreCumPrecipImportRepair =
            'Loaded config was missing advanced_config.storecumprcp; added storecumprcp=1.';
        } else if (String(before).trim() !== String(cfg.advanced_config.storecumprcp)) {
          lastStoreCumPrecipImportRepair =
            `Loaded config had advanced_config.storecumprcp=${before}; synced it to ${cfg.advanced_config.storecumprcp}.`;
        }
      }

      if (writeBackToPage) {
        setFieldValue('store_cumulative_precip', cfg.store_cumulative_precip);
        setFieldValue('advanced_config', cfg.advanced_config);
      }

      return cfg;
    }


    function manualStripGridAuthorityAdvancedKeys(cfg) {
      if (!cfg || typeof cfg !== 'object') {
        return cfg;
      }
    
      if (!cfg.advanced_config || typeof cfg.advanced_config !== 'object' || Array.isArray(cfg.advanced_config)) {
        return cfg;
      }
    
      const forbiddenAdvancedGridKeys = [
        'mmax',
        'nmax',
        'dx',
        'dy',
        'x0',
        'y0',
        'rotation',
        'epsg'
      ];
    
      for (const key of forbiddenAdvancedGridKeys) {
        delete cfg.advanced_config[key];
      }
    
      return cfg;
    }


    function getConfig() {
      // Start from keys loaded from an existing backend JSON but not rendered by this page.
      // Rendered Manual fields then overwrite matching keys, so visible edits always win.
      const cfg = { ...extraLoadedConfig };

      document.querySelectorAll('[data-key]').forEach(el => {
        const key = el.dataset.key;
        try {
          cfg[key] = parseValue(el);
          el.style.borderColor = '';
        } catch (err) {
          cfg[key] = `JSON_PARSE_ERROR: ${err.message}`;
          el.style.borderColor = 'var(--bad)';
        }
      });

      const fixedCfg = applyManualFixedConfig(cfg);
      manualSyncDemSourceZmin(fixedCfg);
      manualSyncStoreCumulativePrecip(fixedCfg);
      manualStripGridAuthorityAdvancedKeys(fixedCfg);
      return fixedCfg;
    }

    function setFieldValue(key, value) {
      const el = document.querySelector(`[data-key="${CSS.escape(key)}"]`);
      if (!el) return false;
      const type = el.dataset.type || 'string';
      el.value = stringifyForField(value, type);
      return true;
    }

    function plannedRunRoot(cfg) {
      const outputRoot = (cfg.output_root || '').replace(/\/+$/, '');
      const runName = cfg.run_name || 'UNSET_RUN_NAME';
      return outputRoot ? `${outputRoot}/${runName}` : runName;
    }

    function updatePreview() {
      const cfg = getConfig();
      const root = plannedRunRoot(cfg);
      if (runRootPreview) runRootPreview.textContent = root;
      if (sideRunRootPreview) sideRunRootPreview.textContent = `${root}/run_config.json`;
      if (preview) preview.textContent = JSON.stringify(cfg, null, 2);
    }

    function makeCheck(status, message, detail) {
      const div = document.createElement('div');
      div.className = `check-item ${status}`;
      const label = status === 'good' ? 'OK' : status === 'warn' ? 'WARN' : 'FAIL';
      div.innerHTML = `<div class="check-status">${label}</div><div><b>${message}</b><br><span class="muted">${detail || ''}</span></div>`;
      return div;
    }
    
    function manualReviewEsc(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }
    
    function renderRuntimeWindowReview(audit) {
      const target = document.getElementById('runtime-window-review-output');
      if (!target) return;
    
      const color = audit.ui_color || 'green';
      const border = color === 'red' ? '#dc2626' : color === 'yellow' ? '#d97706' : '#16a34a';
      const background = color === 'red' ? '#fff1f2' : color === 'yellow' ? '#fffbeb' : '#f0fdf4';
      const text = color === 'red' ? '#991b1b' : color === 'yellow' ? '#92400e' : '#166534';
    
      const mismatches = audit.mismatches || {};
      const mismatchRows = Object.entries(mismatches).map(([key, item]) => `
        <div style="margin-top: 0.5rem;">
          <strong>${manualReviewEsc(key)}</strong>:
          requested <code>${manualReviewEsc(item.requested_normalized || item.requested_raw || '')}</code>,
          effective <code>${manualReviewEsc(item.effective_normalized || item.effective_raw || '')}</code>
        </div>
      `).join('');
    
      target.innerHTML = `
        <div style="margin-top: 1rem; margin-bottom: 1rem; padding: 1rem; border-radius: 14px; border: 2px solid ${border}; background: ${background}; color: ${text};">
          <div><strong>${manualReviewEsc(audit.message || 'Runtime-window review complete.')}</strong></div>
          <div style="margin-top: 0.45rem;">Category: <code>${manualReviewEsc(audit.category || '')}</code></div>
          <div style="margin-top: 0.45rem;">Reason: ${manualReviewEsc(audit.reason || '')}</div>
          <div style="margin-top: 0.45rem;">Event catalog: <code>${manualReviewEsc(audit.event_catalog || '')}</code></div>
          <div style="margin-top: 0.45rem;">Runtime CSV: <code>${manualReviewEsc(audit.runtime_source_csv || '')}</code></div>
          ${mismatchRows}
        </div>
      `;
    }
    
    async function runRuntimeWindowReviewCheck() {
      const target = document.getElementById('runtime-window-review-output');
      if (target) {
        target.innerHTML = `
          <div style="margin-top: 1rem; margin-bottom: 1rem; padding: 0.8rem; border-radius: 12px; background: #f8fafc; border: 1px solid #cbd5e1;">
            Checking requested model window against selected event catalog runtime window.
          </div>
        `;
      }
    
      let cfg;
      try {
        cfg = getConfig();
      } catch (err) {
        renderRuntimeWindowReview({
          severity: 'major',
          ui_color: 'red',
          category: 'runtime_window_review_failed',
          message: 'Runtime window review failed before request.',
          reason: err.message,
          mismatches: {}
        });
        return;
      }
    
      try {
