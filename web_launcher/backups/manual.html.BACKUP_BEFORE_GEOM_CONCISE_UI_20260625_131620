          ));
        }
      }

      // Wind/pressure consistency.
      if (cfg.use_wind && !hasAnyValue(['wind_path', 'wind_source'])) {
        checks.push(makeCheck(
          'bad',
          'Wind is enabled but no wind path/source is set.',
          'Set wind_path or wind_source, or disable wind.'
        ));
      } else if (cfg.use_wind) {
        checks.push(makeCheck(
          'good',
          'Wind is enabled with a path/source.',
          cfg.wind_path || cfg.wind_source
        ));
      }

      if (cfg.use_pressure && !hasAnyValue(['pressure_path', 'pressure_source'])) {
        checks.push(makeCheck(
          'bad',
          'Pressure is enabled but no pressure path/source is set.',
          'Set pressure_path or pressure_source, or disable pressure.'
        ));
      } else if (cfg.use_pressure) {
        checks.push(makeCheck(
          'good',
          'Pressure is enabled with a path/source.',
          cfg.pressure_path || cfg.pressure_source
        ));
      }

    // Active-mask / subgrid consistency.
    if (!isBlank(cfg.active_mask_path)) {
      checks.push(makeCheck(
        'good',
        'active_mask_path is set.',
        'The active mask will be sampled onto the Manual model grid. It will not define grid geometry.'
      ));
    
      if (cfg.active_mask_mode === 'sample_to_grid') {
        checks.push(makeCheck(
          'good',
          'active_mask_mode is sample_to_grid.',
          'This is the intended Manual behavior.'
        ));
      } else {
        checks.push(makeCheck(
          'bad',
          'Unsupported active_mask_mode.',
          `Current active_mask_mode = ${cfg.active_mask_mode}. Use sample_to_grid.`
        ));
      }
    } else if (cfg.use_subgrid) {
      checks.push(makeCheck(
        'warn',
