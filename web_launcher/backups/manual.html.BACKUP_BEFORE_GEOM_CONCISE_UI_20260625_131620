          ));
        } else if (bufferM > 500) {
          checks.push(makeCheck(
            'warn',
            'open_boundary_outline_buffer_m is large.',
            `${bufferM} m may open too many cells unless this is intentional.`
          ));
        }

        if (minCells < 0 || maxCells < 0) {
          checks.push(makeCheck(
            'bad',
            'open-boundary cell thresholds must be non-negative.',
            `min=${cfg.open_boundary_min_cells}, max=${cfg.open_boundary_max_cells}`
