          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({config: cfg})
        });

        const rawText = await response.text();
        let result;

        try {
          result = rawText ? JSON.parse(rawText) : {};
        } catch (err) {
          result = {
            ok: false,
            error: `Response was not JSON: ${err.message}`,
            raw_response: rawText
          };
        }

        result.http_status = response.status;
        result.http_status_text = response.statusText;

        if (!rawText) {
          result.ok = false;
          result.error = result.error || 'Endpoint returned an empty response body.';
          result.raw_response = '';
        }

        renderGeometryCheckResult(result, 'LOCAL');

        if (!response.ok || !result.ok) {
          setGeometryButtonState(button, 'bad');
          return;
        }

        setGeometryButtonState(button, 'good');
      } catch (err) {
        setGeometryButtonState(button, 'bad');
        if (target) {
          target.textContent = `Geometry check request failed:\n${err.stack || err.message}`;
