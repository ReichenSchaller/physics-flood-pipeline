          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ config: cfg })
        });
    
        const result = await response.json();
    
        if (!response.ok || !result.ok) {
          throw new Error(result.error || 'Runtime review request failed.');
        }
    
        renderRuntimeWindowReview(result.audit || {});
      } catch (err) {
        renderRuntimeWindowReview({
          severity: 'major',
          ui_color: 'red',
          category: 'runtime_window_review_failed',
          message: 'Runtime window review request failed.',
          reason: err.message,
          mismatches: {}
        });
      }
    }


    function manualCatalogReadList() {
      const el = document.querySelector('[data-key="data_catalogs"]');

      if (!el) {
        return [];
      }

      try {
        const parsed = JSON.parse(el.value || '[]');
        return Array.isArray(parsed)
          ? parsed.map(item => String(item).trim()).filter(Boolean)
          : [];
      } catch (err) {
        return String(el.value || '')
          .replaceAll(',', '\n')
          .split('\n')
          .map(item => item.trim())
          .filter(Boolean);
      }
    }

    function manualCatalogWriteList(items) {
      const cleaned = Array.from(
        new Set(
          (items || [])
            .map(item => String(item).trim())
            .filter(Boolean)
        )
      );

      setFieldValue('data_catalogs', cleaned);
      manualRenderCatalogList();
      updatePreview();
      return cleaned;
    }

    function manualAddCatalogFromInput() {
      const input = document.getElementById('manual-catalog-add-input');
      const target = document.getElementById('manual-catalog-detection-output');

      if (!input) {
        if (target) {
          target.innerHTML = `
            <div class="check-item bad">
              <div class="check-status">FAIL</div>
              <div><b>Add catalog input is missing.</b><br><span class="muted">Could not find #manual-catalog-add-input.</span></div>
            </div>
          `;
        }
        return;
      }

      const value = String(input.value || '').trim();

      if (!value) {
        if (target) {
          target.innerHTML = `
            <div class="check-item warn">
              <div class="check-status">EMPTY</div>
              <div><b>No catalog path to add.</b><br><span class="muted">Use Browse first, or paste a catalog path into the box next to Browse.</span></div>
            </div>
          `;
        }
        return;
      }

      const current = manualCatalogReadList();

      if (!current.includes(value)) {
        current.push(value);
      }

