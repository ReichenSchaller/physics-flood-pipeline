    document.getElementById('geometry-check-local-button').addEventListener('click', runManualGeometryCheckLocal);
    document.getElementById('geometry-check-submit-button').addEventListener('click', submitManualGeometryCheck);

    // Expose Manual Mode hooks for reusable static helpers such as pipeline_actions.js.
    window.getConfig = getConfig;
    window.setFieldValue = setFieldValue;
    window.updatePreview = updatePreview;
    window.runChecks = runChecks;
    window.runManualGeometryCheckLocal = runManualGeometryCheckLocal;
    window.submitManualGeometryCheck = submitManualGeometryCheck;
    window.showTab = showTab;
    window.getExtraLoadedConfig = () => ({ ...extraLoadedConfig });
