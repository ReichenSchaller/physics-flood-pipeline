      --radius: 22px;
      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--sans);
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.13), transparent 34rem),
        radial-gradient(circle at bottom right, rgba(15, 118, 110, 0.08), transparent 30rem),
        var(--bg);
    }

    a {
      color: var(--accent);
    }

    .shell {
      width: min(1120px, calc(100% - 36px));
      margin: 0 auto;
      padding: 32px 0 54px;
    }

    .topbar {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      margin-bottom: 20px;
    }

    .back-link {
      text-decoration: none;
      font-weight: 700;
      color: var(--text);
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      box-shadow: 0 8px 24px rgba(21, 34, 66, 0.06);
    }

    .hero {
      background: rgba(255, 255, 255, 0.90);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 28px;
      box-shadow: var(--shadow);
      margin-bottom: 20px;
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.2rem);
      letter-spacing: -0.045em;
      line-height: 1;
    }

    .byline {
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 0.96rem;
      font-weight: 650;
    }

    .description {
      margin: 14px 0 0;
      color: var(--muted);
      max-width: 760px;
      font-size: 1.04rem;
      line-height: 1.6;
    }

    .tabbar-wrap {
      position: sticky;
      top: 0;
      z-index: 10;
      padding: 10px 0;
      background: linear-gradient(
        to bottom,
        rgba(246, 248, 251, 0.96),
        rgba(246, 248, 251, 0.78)
      );
      backdrop-filter: blur(8px);
      margin-bottom: 14px;
    }

    .tabbar {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 10px;
      background: rgba(255, 255, 255, 0.90);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 10px;
      box-shadow: 0 12px 34px rgba(21, 34, 66, 0.08);
    }

    .tab-button {
      appearance: none;
      border: 0;
      border-radius: 16px;
      padding: 12px 10px;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      color: var(--muted);
      background: transparent;
      transition: 0.15s ease;
    }

    .tab-button:hover {
      color: var(--text);
      background: var(--panel-soft);
    }

    .tab-button.active {
      color: #ffffff;
      background: var(--accent);
      box-shadow: 0 10px 22px rgba(37, 99, 235, 0.25);
    }

    .panel {
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 12px 32px rgba(21, 34, 66, 0.08);
      padding: 34px;
      min-height: 420px;
    }

    .tab-section {
      display: none;
    }

    .tab-section.active {
      display: block;
      animation: fadeIn 0.18s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    h2 {
      margin: 0 0 16px;
      font-size: 2rem;
      letter-spacing: -0.03em;
    }

    .coming-soon {
      margin: 0;
      color: var(--muted);
      font-size: 1.25rem;
      line-height: 1.6;
      font-weight: 650;
    }

    @media (max-width: 960px) {
      .tabbar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .shell {
        width: min(100% - 22px, 1120px);
        padding-top: 18px;
      }

      .hero,
      .panel {
        padding: 22px;
      }

      .tabbar {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

