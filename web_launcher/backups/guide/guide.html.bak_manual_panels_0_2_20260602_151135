<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sfincs Web launcher guide</title>

  <style>
    :root {
      --bg: #f6f8fb;
      --panel: #ffffff;
      --panel-soft: #f9fbff;
      --text: #172033;
      --muted: #475467;
      --border: #d9e1ec;
      --accent: #2563eb;
      --accent-soft: #e8f0ff;
      --shadow: 0 18px 45px rgba(21, 34, 66, 0.10);
      --radius: 22px;
      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--sans);
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.13), transparent 34rem),
        radial-gradient(circle at bottom right, rgba(15, 118, 110, 0.08), transparent 30rem),
        var(--bg);
    }

    a {
      color: var(--accent);
    }

    .shell {
      width: min(1120px, calc(100% - 36px));
      margin: 0 auto;
      padding: 32px 0 54px;
    }

    .topbar {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      margin-bottom: 20px;
    }

    .back-link {
      text-decoration: none;
      font-weight: 700;
      color: var(--text);
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      box-shadow: 0 8px 24px rgba(21, 34, 66, 0.06);
    }

    .hero {
      background: rgba(255, 255, 255, 0.90);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 28px;
      box-shadow: var(--shadow);
      margin-bottom: 20px;
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.2rem);
      letter-spacing: -0.045em;
      line-height: 1;
    }

    .byline {
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 0.96rem;
      font-weight: 650;
    }

    .description {
      margin: 14px 0 0;
      color: var(--muted);
      max-width: 760px;
      font-size: 1.04rem;
      line-height: 1.6;
    }

    .tabbar-wrap {
      position: sticky;
      top: 0;
      z-index: 10;
      padding: 10px 0;
      background: linear-gradient(
        to bottom,
        rgba(246, 248, 251, 0.96),
        rgba(246, 248, 251, 0.78)
      );
      backdrop-filter: blur(8px);
      margin-bottom: 14px;
    }

    .tabbar {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 10px;
      background: rgba(255, 255, 255, 0.90);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 10px;
      box-shadow: 0 12px 34px rgba(21, 34, 66, 0.08);
    }

    .tab-button {
      appearance: none;
      border: 0;
      border-radius: 16px;
      padding: 12px 10px;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      color: var(--muted);
      background: transparent;
      transition: 0.15s ease;
    }

    .tab-button:hover {
      color: var(--text);
      background: var(--panel-soft);
    }

    .tab-button.active {
      color: #ffffff;
      background: var(--accent);
      box-shadow: 0 10px 22px rgba(37, 99, 235, 0.25);
    }

    .panel {
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 12px 32px rgba(21, 34, 66, 0.08);
      padding: 34px;
      min-height: 420px;
    }

    .tab-section {
      display: none;
    }

    .tab-section.active {
      display: block;
      animation: fadeIn 0.18s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    h2 {
      margin: 0 0 16px;
      font-size: 2rem;
      letter-spacing: -0.03em;
    }

    .coming-soon {
      margin: 0;
      color: var(--muted);
      font-size: 1.25rem;
      line-height: 1.6;
      font-weight: 650;
    }

    .manual-guide-shell {
      display: grid;
      gap: 24px;
    }

    .manual-guide-controls {
      display: grid;
      grid-template-columns: minmax(220px, 320px) 1fr;
      gap: 14px;
      align-items: end;
      background: var(--panel-soft);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 18px;
    }

    .manual-guide-label {
      display: grid;
      gap: 8px;
      font-weight: 800;
      color: var(--text);
    }

    .manual-guide-label span {
      color: #344054;
      font-size: 0.95rem;
      font-weight: 650;
    }

    .manual-guide-select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
      font: inherit;
      font-weight: 750;
      color: var(--text);
      background: #ffffff;
    }

    .manual-guide-hint {
      margin: 0;
      color: #344054;
      line-height: 1.55;
    }

    .manual-guide-panel {
      display: none;
    }

    .manual-guide-panel.active {
      display: grid;
      gap: 18px;
      animation: fadeIn 0.18s ease-out;
    }

    .manual-guide-card {
      background: var(--panel-soft);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 22px;
    }

    .manual-guide-card h3 {
      margin: 0 0 12px;
      font-size: 1.28rem;
      letter-spacing: -0.02em;
    }

    .manual-guide-card p {
      margin: 0 0 12px;
      color: #344054;
      line-height: 1.62;
    }

    .manual-guide-card p:last-child {
      margin-bottom: 0;
    }

    .manual-guide-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .manual-mini-card {
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
    }

    .manual-mini-card h4 {
      margin: 0 0 8px;
      font-size: 1rem;
    }

    .manual-mini-card p {
      margin: 0;
      color: #344054;
      line-height: 1.55;
    }

    .manual-field-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: #ffffff;
    }

    .manual-field-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 760px;
      font-size: 0.94rem;
    }

    .manual-field-table th,
    .manual-field-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
      text-align: left;
    }

    .manual-field-table th {
      background: #f4f7fb;
      color: var(--text);
      font-weight: 800;
    }

    .manual-field-table tr:last-child td {
      border-bottom: 0;
    }

    .manual-inline-code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.92em;
      background: #eef3ff;
      border: 1px solid #d8e4ff;
      border-radius: 7px;
      padding: 1px 6px;
      color: #1f3d75;
      white-space: nowrap;
    }

    .manual-callout {
      border-left: 5px solid var(--accent);
      background: var(--accent-soft);
      border-radius: 16px;
      padding: 16px 18px;
      color: var(--text);
    }

    .manual-callout p {
      margin: 0;
      color: var(--text);
      line-height: 1.55;
    }

    .manual-todo-badge {
      display: inline-flex;
      align-items: center;
      width: max-content;
      border-radius: 999px;
      padding: 4px 10px;
      background: #fff7ed;
      border: 1px solid #fed7aa;
      color: #9a3412;
      font-size: 0.82rem;
      font-weight: 800;
      margin-bottom: 10px;
    }

    @media (max-width: 800px) {
      .manual-guide-controls,
      .manual-guide-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 960px) {
      .tabbar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .shell {
        width: min(100% - 22px, 1120px);
        padding-top: 18px;
      }

      .hero,
      .panel {
        padding: 22px;
      }

      .tabbar {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="shell">
    <div class="topbar">
      <a class="back-link" href="/">← Back to launcher</a>
    </div>

    <header class="hero">
      <h1>Sfincs Web launcher guide</h1>
      <p class="byline">Reichen Schaller</p>
      <p class="description">
        The Sfincs intro tab is for someone brand new to SFINCS. The other tabs are for learning how to use each launcher mode, including manual setup, override runs, batch generation, the guided wizard, and run comparison.
      </p>
    </header>

    <div class="tabbar-wrap">
      <nav class="tabbar" aria-label="Guide tabs">
        <button class="tab-button" type="button" data-tab="intro">Sfincs intro</button>
        <button class="tab-button" type="button" data-tab="manual">Manual</button>
        <button class="tab-button" type="button" data-tab="override">Override</button>
        <button class="tab-button" type="button" data-tab="batch">Batch</button>
        <button class="tab-button" type="button" data-tab="wizard">Wizard</button>
        <button class="tab-button" type="button" data-tab="compare">Comparison</button>
      </nav>
    </div>

    <main class="panel">
      <section class="tab-section" id="tab-intro" data-title="Sfincs intro">
        <h2>Sfincs intro</h2>
        <p class="coming-soon">Coming Soon</p>
      </section>
<!--- ----------------------------------------------------------------------------------------------------------------- -->
