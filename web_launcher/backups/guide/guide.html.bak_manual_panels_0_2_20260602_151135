  <script>
    const VALID_TABS = ["intro", "manual", "override", "batch", "wizard", "compare"];

    const TAB_ALIASES = {
      sfincs: "intro",
      general: "intro",
      home: "intro",
      guided: "wizard",
      guide: "wizard",
      comparison: "compare",
      "compare-runs": "compare",
      compare_runs: "compare",
      results: "compare",
      result: "compare"
    };


    const VALID_MANUAL_GUIDE_TABS = [
      "run_identity",
      "pipeline",
      "slurm_general",
      "stage_resources",
      "data_catalogs",
      "required_inputs",
      "optional_inputs",
      "model_settings",
      "elevation_mask",
      "roughness",
      "subgrid",
      "forcing",
      "infiltration",
      "output",
      "advanced",
      "postprocess",
      "safety_debug",
      "backend_paths",
      "check_all",
      "submit"
    ];

    const MANUAL_GUIDE_ALIASES = {
      run: "run_identity",
      identity: "run_identity",
      paths: "backend_paths",
      backend: "backend_paths",
      resources: "stage_resources",
      slurm: "slurm_general",
      catalogs: "data_catalogs",
      inputs: "required_inputs",
      required: "required_inputs",
      optional: "optional_inputs",
      model: "model_settings",
      settings: "model_settings",
      elevation: "elevation_mask",
      mask: "elevation_mask",
      checks: "check_all",
      review: "check_all",
      preflight: "submit",
      build: "submit"
    };

    function normalizeTab(raw) {
      if (!raw) return "intro";

      const cleaned = String(raw).trim().toLowerCase().replace(/^#/, "");
      const normalized = TAB_ALIASES[cleaned] || cleaned;

      return VALID_TABS.includes(normalized) ? normalized : "intro";
    }

    function getInitialTab() {
      const params = new URLSearchParams(window.location.search);
      return normalizeTab(params.get("tab") || window.location.hash);
    }


    function normalizeManualGuideTab(raw) {
      if (!raw) return "run_identity";

      const cleaned = String(raw).trim().toLowerCase().replace(/^#/, "").replaceAll("-", "_");
      const normalized = MANUAL_GUIDE_ALIASES[cleaned] || cleaned;

      return VALID_MANUAL_GUIDE_TABS.includes(normalized) ? normalized : "run_identity";
    }

    function getInitialManualGuideTab() {
      const params = new URLSearchParams(window.location.search);
      return normalizeManualGuideTab(params.get("manualTab") || params.get("manual"));
    }

    function getCurrentManualGuideTab() {
      const select = document.getElementById("manual-guide-select");
      return normalizeManualGuideTab(select ? select.value : "run_identity");
    }

    function setActiveManualGuideTab(tab, updateUrl = true) {
      const active = normalizeManualGuideTab(tab);
      const select = document.getElementById("manual-guide-select");

      if (select) {
        select.value = active;
      }

      document.querySelectorAll("[data-manual-guide-panel]").forEach((panel) => {
        const isActive = panel.dataset.manualGuidePanel === active;
        panel.classList.toggle("active", isActive);
        panel.setAttribute("aria-hidden", isActive ? "false" : "true");
      });

      if (updateUrl) {
        const params = new URLSearchParams();
        params.set("tab", "manual");
        params.set("manualTab", active);
        window.history.replaceState({}, "", `${window.location.pathname}?${params.toString()}`);
      }
    }


    function setActiveTab(tab, updateUrl = true) {
      const active = normalizeTab(tab);

      document.querySelectorAll(".tab-button").forEach((button) => {
        const isActive = button.dataset.tab === active;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      document.querySelectorAll(".tab-section").forEach((section) => {
        const isActive = section.id === `tab-${active}`;
        section.classList.toggle("active", isActive);
        section.setAttribute("aria-hidden", isActive ? "false" : "true");
      });

      if (updateUrl) {
        const params = new URLSearchParams();
        params.set("tab", active);

        if (active === "manual") {
          params.set("manualTab", getCurrentManualGuideTab());
        }

        const newUrl = `${window.location.pathname}?${params.toString()}`;
        window.history.replaceState({}, "", newUrl);
      }

      const activeSection = document.querySelector(`#tab-${active}`);
      if (activeSection && activeSection.dataset.title) {
        document.title = `${activeSection.dataset.title} · Sfincs Web launcher guide`;
      }

      if (active === "manual") {
        setActiveManualGuideTab(getCurrentManualGuideTab(), false);
      }
    }


    document.querySelectorAll(".tab-button").forEach((button) => {
      button.addEventListener("click", () => setActiveTab(button.dataset.tab));
    });
    
    const manualGuideSelect = document.getElementById("manual-guide-select");
    if (manualGuideSelect) {
      manualGuideSelect.addEventListener("change", () => {
        setActiveManualGuideTab(manualGuideSelect.value);
      });
    }

    window.addEventListener("hashchange", () => {
      setActiveTab(getInitialTab());
    });

    setActiveManualGuideTab(getInitialManualGuideTab(), false);
    setActiveTab(getInitialTab(), false);
  </script>
</body>
